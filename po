        local rp = boneco:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116))
        if not rp then return Vector3.new() end
        local offset = Vector3.new(math.random(-2, 2), -5.1, math.random(-2, 2))
        return rp.Position + offset
    end

    local function tpAbaixo(alvo)
        if not alvo or not alvo.Character or not alvo.Character:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116)) then return end
        local meuBoneco = eu.Character
