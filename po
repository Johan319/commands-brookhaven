    local botPos = rootPos - Vector3.new(0, 3.1, 0)
    local topScreen, topDepth, topOnScreen = getScreenPosition(topPos)
    local botScreen, botDepth, botOnScreen = getScreenPosition(botPos)
    if not topOnScreen and not botOnScreen then
        hideESP(plr)
        return
    end
    local color = getPlayerColor(plr)
    local boxHeight = math.abs(topScreen.Y - botScreen.Y)
    local boxWidth = boxHeight * 0.45
    local left = topScreen.X - boxWidth
    local right = topScreen.X + boxWidth
    local top = topScreen.Y
    local bottom = botScreen.Y
    local corners = {
        {from = Vector2.new(left, top), to = Vector2.new(right, top)},
        {from = Vector2.new(right, top), to = Vector2.new(right, bottom)},
        {from = Vector2.new(right, bottom), to = Vector2.new(left, bottom)},
        {from = Vector2.new(left, bottom), to = Vector2.new(left, top)},
    }
    for i, seg in ipairs(corners) do
        local line = d.BoxLines[i]
        line.From = seg.from
        line.To = seg.to
        line.Color = color
        line.Visible = IIlIIlll.ShowBox
    end
    d.NameLabel.Text = plr.DisplayName
    d.NameLabel.Position = Vector2.new(topScreen.X, top - 16)
    d.NameLabel.Color = IIlIIlll.NameColor
    d.NameLabel.Visible = IIlIIlll.ShowName
    d.DistLabel.Text = string.format(string.char(91,37,100,93), math.floor(distance))
    d.DistLabel.Position = Vector2.new(topScreen.X, bottom + 2)
    d.DistLabel.Color = IIlIIlll.DistanceColor
    d.DistLabel.Visible = IIlIIlll.ShowDistance
    if IIlIIlll.ShowHealth then
        local hpRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
        local barX = left - 5
        local filledY = bottom - (boxHeight * hpRatio)
        d.HealthBG.From = Vector2.new(barX, top)
        d.HealthBG.To = Vector2.new(barX, bottom)
        d.HealthBG.Visible = true
        d.HealthBar.From = Vector2.new(barX, filledY)
        d.HealthBar.To = Vector2.new(barX, bottom)
        d.HealthBar.Color = Color3.fromRGB(math.floor(255*(1-hpRatio)), math.floor(255*hpRatio), 0)
        d.HealthBar.Visible = true
    else
        d.HealthBG.Visible = false
        d.HealthBar.Visible = false
    end
end

