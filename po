    local eu = jogadores.LocalPlayer
    local loopTP = nil
    local sofaEquipado = false
    local base = nil
    local posInicial = nil
    local raiz = nil
    local nomeAlvo = targetPlayer.Name

    local function limparSofa()
        if loopTP then
            loopTP:Disconnect()
            loopTP = nil
        end
        if sofaEquipado then
            local boneco = eu.Character
            if boneco then
                local sofa = boneco:FindFirstChild(string.char(67,111,117,99,104))
                if sofa then
                    sofa.Parent = eu.Backpack
                    sofaEquipado = false
                end
            end
        end
        if base then
            base:Destroy()
            base = nil
        end
        if getgenv().AntiSit then
            getgenv().AntiSit:Set(false)
        end
        local humano = eu.Character and eu.Character:FindFirstChildOfClass(string.char(72,117,109,97,110,111,105,100))
        if humano then
            humano:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
            humano:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if posInicial and raiz then
            raiz.CFrame = posInicial
            posInicial = nil
        end
    end

    local function pegarSofa()
        local boneco = eu.Character
        if not boneco then return end
        local mochila = eu.Backpack
        if not mochila:FindFirstChild(string.char(67,111,117,99,104)) and not boneco:FindFirstChild(string.char(67,111,117,99,104)) then
            local args2 = { string.char(80,105,99,107,105,110,103,84,111,111,108,115), string.char(67,111,117,99,104) }
            rep.RE[string.char(49,84,111,111,49,108)]:InvokeServer(unpack(args2))
            task.wait(0.1)
        end
        local sofa = mochila:FindFirstChild(string.char(67,111,117,99,104)) or boneco:FindFirstChild(string.char(67,111,117,99,104))
        if sofa then
            sofa.Parent = boneco
            sofaEquipado = true
        end
    end

