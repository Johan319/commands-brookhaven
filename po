    end)
    task.wait(0.1)

    hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    hum.PlatformStand = false
    workspace.CurrentCamera.CameraSubject = target.Character:FindFirstChild(string.char(72,101,97,100)) or tRoot or hum

