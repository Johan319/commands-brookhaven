local userIdCache = {}

local function getUserId(username)

    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr.Name == username then
            userIdCache[username] = plr.UserId
            return plr.UserId
        end
    end
    if userIdCache[username] then
        return userIdCache[username]
    end
    local uid = nil
    pcall(function()
        uid = game.Players:GetUserIdFromNameAsync(username)
    end)
    if uid then userIdCache[username] = uid end
    return uid
end

