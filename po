local jogadores = game:GetService(string.char(80,108,97,121,101,114,115))
    local rep = game:GetService(string.char(82,101,112,108,105,99,97,116,101,100,83,116,111,114,97,103,101))
    local loop = game:GetService(string.char(82,117,110,83,101,114,118,105,99,101))
    local mundo = game:GetService(string.char(87,111,114,107,115,112,97,99,101))

    local eu = jogadores.LocalPlayer
    local loopTP = nil
    local sofaEquipado = false
    local base = nil
    local posInicial = nil
    local raiz = nil
    local nomeAlvo = targetPlayer.Name

    local function limparSofa()
        if loopTP then
            loopTP:Disconnect()
            loopTP = nil
        end
        if sofaEquipado then
            local boneco = eu.Character
            if boneco then
                local sofa = boneco:FindFirstChild(string.char(67,111,117,99,104))
                if sofa then
                    sofa.Parent = eu.Backpack
                    sofaEquipado = false
                end
            end
        end
        if base then
            base:Destroy()
            base = nil
        end
        if getgenv().AntiSit then
            getgenv().AntiSit:Set(false)
        end
        local humano = eu.Character and eu.Character:FindFirstChildOfClass(string.char(72,117,109,97,110,111,105,100))
        if humano then
            humano:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
            humano:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if posInicial and raiz then
            raiz.CFrame = posInicial
            posInicial = nil
        end
    end

    local function pegarSofa()
        local boneco = eu.Character
        if not boneco then return end
        local mochila = eu.Backpack
        if not mochila:FindFirstChild(string.char(67,111,117,99,104)) and not boneco:FindFirstChild(string.char(67,111,117,99,104)) then
            local args2 = { string.char(80,105,99,107,105,110,103,84,111,111,108,115), string.char(67,111,117,99,104) }
            rep.RE[string.char(49,84,111,111,49,108)]:InvokeServer(unpack(args2))
            task.wait(0.1)
        end
        local sofa = mochila:FindFirstChild(string.char(67,111,117,99,104)) or boneco:FindFirstChild(string.char(67,111,117,99,104))
        if sofa then
            sofa.Parent = boneco
            sofaEquipado = true
        end
    end

    local function posAleatoriaAbaixo(boneco)
        local rp = boneco:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116))
        if not rp then return Vector3.new() end
        local offset = Vector3.new(math.random(-2, 2), -5.1, math.random(-2, 2))
        return rp.Position + offset
    end

    local function tpAbaixo(alvo)
        if not alvo or not alvo.Character or not alvo.Character:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116)) then return end
        local meuBoneco = eu.Character
        local minhaRaiz = meuBoneco and meuBoneco:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116))
        local humano = meuBoneco and meuBoneco:FindFirstChildOfClass(string.char(72,117,109,97,110,111,105,100))
        if not minhaRaiz or not humano then return end

        humano:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        if not base then
            base = Instance.new(string.char(80,97,114,116))
            base.Size = Vector3.new(10, 1, 10)
            base.Anchored = true
            base.CanCollide = true
            base.Transparency = 0.5
            base.Parent = mundo
        end
        local destino = posAleatoriaAbaixo(alvo.Character)
        base.Position = destino
        minhaRaiz.CFrame = CFrame.new(destino)
        humano:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
    end

    local boneco = eu.Character
    if not boneco then
        addLog(string.char(89,111,117,114,32,99,104,97,114,97,99,116,101,114,32,110,111,116,32,102,111,117,110,100))
        return false
    end

    posInicial = boneco:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116)) and boneco.HumanoidRootPart.CFrame
    raiz = boneco:FindFirstChild(string.char(72,117,109,97,110,111,105,100,82,111,111,116,80,97,114,116))
    pegarSofa()

    loopTP = loop.Heartbeat:Connect(function()
        local alvoAtual = jogadores:FindFirstChild(nomeAlvo)
        if not alvoAtual or not alvoAtual.Character or not alvoAtual.Character:FindFirstChild(string.char(72,117,109,97,110,111,105,100)) then
            limparSofa()
            return
        end
        if getgenv().AntiSit then getgenv().AntiSit:Set(true) end
        tpAbaixo(alvoAtual)
    end)

    task.spawn(function()
        local alvoAtual = jogadores:FindFirstChild(nomeAlvo)
        while alvoAtual and alvoAtual.Character and alvoAtual.Character:FindFirstChild(string.char(72,117,109,97,110,111,105,100)) do
            task.wait(0.05)
            if alvoAtual.Character.Humanoid.SeatPart then
                local buraco = CFrame.new(voidX, voidY, voidZ)
                alvoAtual.Character.HumanoidRootPart.CFrame = buraco
                eu.Character.HumanoidRootPart.CFrame = buraco
                task.wait(0.4)
                limparSofa()
                task.wait(0.2)
                if posInicial then
                    eu.Character.HumanoidRootPart.CFrame = posInicial
                end
                break
            end
        end
    end)

    addLog(IlIlIlIl.Name .. string.char(32,91) .. getPlayerRank(IlIlIlIl) .. string.char(93,32,106,97,105,108,101,100,32) .. targetPlayer.Name)
    return true
end

