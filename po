--   THUMBNAIL FETCH
-- =====================
local function FetchThumbnail(gameId, imageLabel)
    task.spawn(function()
        local ok, res = pcall(game.HttpGet, game,
            string.format(C.ThumbAPI, tostring(gameId))
        )
        if not ok then return end
        local ok2, data = pcall(HttpService.JSONDecode, HttpService, res)
        if not ok2 then return end
        if data and data.data and data.data[1] then
            local url = data.data[1].imageUrl
            if url and url ~= "" then
                imageLabel.Image = url
            end
        end
    end)
end

