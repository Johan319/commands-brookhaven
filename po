-- =====================
--   SEARCH
-- =====================
local function DoSearch(q)
    q = q:match("^%s*(.-)%s*$")
    if q == "" then return end
    ClearCards()
    Status.Text = "Searching..."
    Status.TextColor3 = C.Accent

    local ok, res = pcall(game.HttpGet, game, string.format(C.API, HttpService:UrlEncode(q)))
    if not ok then
        Status.Text = "HTTP request failed. Enable HTTP requests."
        Status.TextColor3 = C.Red
        return
    end

    local ok2, data = pcall(HttpService.JSONDecode, HttpService, res)
    if not ok2 or not data or not data.result then
        Status.Text = "Could not parse response."
        Status.TextColor3 = C.Red
        return
    end

    local scripts = data.result.scripts
    if not scripts or #scripts == 0 then
        Status.Text = 'No results for "' .. q .. '"'
        Status.TextColor3 = C.Sub
        return
    end

    Status.Text = #scripts .. ' results for "' .. q .. '"'
    Status.TextColor3 = C.Green

    for i, s in ipairs(scripts) do
        MakeCard(s, i)
    end
end

GoBtn.MouseButton1Click:Connect(function() DoSearch(SBox.Text) end)
SBox.FocusLost:Connect(function(enter) if enter then DoSearch(SBox.Text) end end)

-- =====================
--   DRAGGING (on Main directly)
-- =====================
local dragging = false
local dragStart, startPos

TBar.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or
       inp.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = inp.Position
        startPos = Main.Position
    end
end)

TBar.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or
       inp.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(inp)
    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or
                     inp.UserInputType == Enum.UserInputType.Touch) then
        local delta = inp.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        -- Keep shadow in sync
        Shadow.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X + 240,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y + 185 + 6
        )
    end
end)

