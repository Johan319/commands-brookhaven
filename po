local function stopLoopKill(searchName)
    local foundKey = nil
    local s = searchName:lower()
    for name, _ in pairs(IlIIllll) do
        if name:lower() == s or name:lower():find(s, 1, true) then
            foundKey = name
            break
        end
    end
    if not foundKey then
        addLog(string.char(78,111,32,97,99,116,105,118,101,32,108,111,111,112,32,107,105,108,108,32,102,111,117,110,100,32,102,111,114,58,32) .. searchName)
        return
    end
    local killData = IlIIllll[foundKey]
    killData.running = false
    if killData.loopTP then
        killData.loopTP:Disconnect()
        killData.loopTP = nil
    end
    if killData.cleanup then killData.cleanup() end
    IlIIllll[foundKey] = nil
    addLog(IlIlIlIl.Name .. string.char(32,115,116,111,112,112,101,100,32,108,111,111,112,107,105,108,108,32,111,110,58,32) .. foundKey)
end

local function stopAllLoopKills()
    for name, data in pairs(IlIIllll) do
        data.running = false
        if data.loopTP then data.loopTP:Disconnect() end
        if data.cleanup then data.cleanup() end
        IlIIllll[name] = nil
        addLog(string.char(85,110,108,111,111,112,32,107,105,108,108,32,40,97,108,108,41,58,32) .. name)
    end
end

