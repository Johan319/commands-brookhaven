-- =====================
--   MODAL LOGIC
-- =====================
local selectedScript = nil

local function OpenModal(data)
    selectedScript = data
    BtnExecute.Text = "EXECUTE SELECTED SCRIPT"
    BtnEditor.Text  = "OPEN SCRIPT IN EDITOR"
    BtnSave.Text    = "SAVE SELECTED SCRIPT"
    BtnCopy.Text    = "COPY TO CLIPBOARD"
    Overlay.Visible = true
    Modal.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(Modal, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 290, 0, 238)
    }):Play()
end

local function CloseModal()
    TweenService:Create(Modal, TweenInfo.new(0.15), {Size = UDim2.new(0, 0, 0, 0)}):Play()
    task.wait(0.18)
    Overlay.Visible = false
    selectedScript = nil
end

MClose.MouseButton1Click:Connect(CloseModal)

BtnExecute.MouseButton1Click:Connect(function()
    if not selectedScript then return end
    local src = selectedScript.script
    if not src or src == "" then
        BtnExecute.Text = "No Script Content"
        task.wait(2); BtnExecute.Text = "EXECUTE SELECTED SCRIPT"
        return
    end
    CloseModal()
    task.spawn(function()
        local fn, err = loadstring(src)
        if fn then
            local ok, runErr = pcall(fn)
            if not ok then warn("GhostHub Execute Error: " .. tostring(runErr)) end
        else
            warn("GhostHub Loadstring Error: " .. tostring(err))
        end
    end)
end)

BtnEditor.MouseButton1Click:Connect(function()
    if not selectedScript then return end
    pcall(setclipboard, selectedScript.script or "")
    BtnEditor.Text = "Copied to Clipboard"
    task.wait(2); BtnEditor.Text = "OPEN SCRIPT IN EDITOR"
end)

BtnSave.MouseButton1Click:Connect(function()
    if not selectedScript then return end
    local name = (selectedScript.title or "script"):gsub("[^%w%s]", ""):gsub("%s+", "_")
    local ok = pcall(writefile, name .. ".lua", selectedScript.script or "")
    BtnSave.Text = ok and "Saved!" or "Save Failed"
    task.wait(2); BtnSave.Text = "SAVE SELECTED SCRIPT"
end)

BtnCopy.MouseButton1Click:Connect(function()
    if not selectedScript then return end
    pcall(setclipboard, selectedScript.script or "")
    BtnCopy.Text = "Copied!"
    task.wait(2); BtnCopy.Text = "COPY TO CLIPBOARD"
end)

