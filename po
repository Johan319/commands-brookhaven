-- Teleport function
local function teleportTo(targetPlayer)
    local character = player.Character
    local targetChar = targetPlayer.Character
    if character and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.CFrame = targetChar.HumanoidRootPart.CFrame
            addLog("Teleported to " .. targetPlayer.DisplayName .. " [" .. getPlayerRank(targetPlayer) .. "]")
        end
    end
end

-- Find player function
local function findPlayer(searchName)
    local searchLower = searchName:lower()
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr.Name:lower():sub(1, #searchLower) == searchLower then
            return plr
        end
        if plr.DisplayName and plr.DisplayName:lower():sub(1, #searchLower) == searchLower then
            return plr
        end
    end
    return nil
end

-- Update prefix display when changed
local function updatePrefixDisplay()
    prefixLabel.Text = "Prefix: " .. prefix
end

-- Command handler
player.Chatted:Connect(function(msg)
    if msg:sub(1, 1) == prefix then
        local args = {}
        for arg in msg:sub(2):gmatch("%S+") do
            table.insert(args, arg)
        end
        
        local command = args[1] and args[1]:lower()
        local targetName = args[2]
        
        if command == "tp" or command == "goto" or command == "to" then
            if targetName then
                local target = findPlayer(targetName)
                if target then
                    teleportTo(target)
                    commandCount = commandCount + 1
                    counterLabel.Text = tostring(commandCount)
                    addLog(player.DisplayName .. " [" .. getPlayerRank(player) .. "] used /" .. command .. " " .. targetName)
                else
                    addLog("Player not found: " .. targetName)
                end
            end
        elseif command == "prefix" then
            local newPrefix = args[2]
            if newPrefix and #newPrefix == 1 then
                prefix = newPrefix
                updatePrefixDisplay()
                addLog("Prefix changed to: " .. prefix)
            else
                addLog("Usage: prefix <single character>")
            end
        end
    end
end)

-- Show all players and their ranks when script loads
local function showAllRanks()
    local rankList = ""
    for _, plr in pairs(game.Players:GetPlayers()) do
        rankList = rankList .. plr.Name .. " [" .. getPlayerRank(plr) .. "]\n"
    end
    print("=== Players in Server ===\n" .. rankList)
    addLog("Ranks loaded! Total players: " .. #game.Players:GetPlayers())
end

